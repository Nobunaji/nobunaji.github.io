---
interface CategoryStat {
  name: string;
  solvedCount: number;
  totalCount: number;
  percentage: number;
}

let categories: CategoryStat[] = [];
let isLoading = false;
let errorMessage = "";

try {
  const apiKey = import.meta.env.ROOTME_API_KEY;
  const userId = import.meta.env.ROOTME_USER_ID;

  if (!apiKey || !userId) {
    errorMessage = "API credentials not configured";
  } else {
    // Fetch user's solved challenges
    const userResponse = await fetch(`https://api.www.root-me.org/auteurs/${userId}/solutions`, {
      headers: {
        Cookie: `api_key=${apiKey}`,
      },
    });

    if (!userResponse.ok) {
      throw new Error(`User challenges fetch failed: ${userResponse.status}`);
    }

    const userChallenges = await userResponse.json();
    const solvedByCategory = new Map<string, number>();

    // Count solved challenges per category
    if (Array.isArray(userChallenges)) {
      userChallenges.forEach((challenge: any) => {
        const categoryName = challenge.rubrique?.nom || "Unknown";
        solvedByCategory.set(categoryName, (solvedByCategory.get(categoryName) || 0) + 1);
      });
    }

    // Fetch all challenges to get totals per category
    const allChallengesResponse = await fetch("https://api.www.root-me.org/challenges", {
      headers: {
        Cookie: `api_key=${apiKey}`,
      },
    });

    if (!allChallengesResponse.ok) {
      throw new Error(`All challenges fetch failed: ${allChallengesResponse.status}`);
    }

    const allChallenges = await allChallengesResponse.json();
    const totalByCategory = new Map<string, number>();

    // Count total challenges per category
    if (Array.isArray(allChallenges)) {
      allChallenges.forEach((challenge: any) => {
        const categoryName = challenge.rubrique?.nom || "Unknown";
        totalByCategory.set(categoryName, (totalByCategory.get(categoryName) || 0) + 1);
      });
    }

    // Build category stats
    const statsMap = new Map<string, CategoryStat>();

    totalByCategory.forEach((totalCount, categoryName) => {
      const solvedCount = solvedByCategory.get(categoryName) || 0;
      const percentage = totalCount > 0 ? Math.round((solvedCount / totalCount) * 100) : 0;

      statsMap.set(categoryName, {
        name: categoryName,
        solvedCount,
        totalCount,
        percentage,
      });
    });

    // Sort by percentage descending, then by name
    categories = Array.from(statsMap.values()).sort((a, b) => {
      if (b.percentage !== a.percentage) {
        return b.percentage - a.percentage;
      }
      return a.name.localeCompare(b.name);
    });
  }
} catch (error) {
  console.error("Failed to fetch Root-Me category stats:", error);
  errorMessage = error instanceof Error ? error.message : "Failed to load category statistics";
}
---

<div class="rootme-category-stats">
  {errorMessage && <p class="error-message">{errorMessage}</p>}

  {categories.length > 0 && (
    <div class="stats-container">
      <h3>Challenge Categories</h3>
      <div class="categories-list">
        {categories.map((category) => (
          <div class="category-item">
            <div class="category-info">
              <span class="category-name">{category.name}</span>
              <span class="category-progress">
                {category.solvedCount}/{category.totalCount}
              </span>
            </div>
            <div class="progress-bar">
              <div
                class="progress-fill"
                style={`width: ${category.percentage}%`}
              >
                <span class="percentage-text">{category.percentage}%</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  {categories.length === 0 && !errorMessage && <p class="no-data">Loading category statistics...</p>}
</div>

<style>
  .rootme-category-stats {
    background: rgba(0, 240, 255, 0.05);
    border: 1px solid rgba(0, 240, 255, 0.2);
    border-radius: 8px;
    padding: 1.5rem;
    color: #e0e0e0;
  }

  .rootme-category-stats h3 {
    margin: 0 0 1rem 0;
    color: #00f0ff;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .error-message {
    color: #ff6b6b;
    font-size: 0.9rem;
    margin: 0;
  }

  .no-data {
    color: #888;
    font-size: 0.9rem;
    margin: 0;
  }

  .categories-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .category-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .category-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .category-name {
    font-weight: 500;
    color: #e0e0e0;
  }

  .category-progress {
    font-size: 0.85rem;
    color: #00f0ff;
  }

  .progress-bar {
    width: 100%;
    height: 24px;
    background: rgba(0, 240, 255, 0.1);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(0, 240, 255, 0.15);
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, rgba(0, 240, 255, 0.4), rgba(0, 240, 255, 0.8));
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    position: relative;
    transition: width 0.6s ease;
  }

  .progress-fill::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1));
    animation: shimmer 2s infinite;
  }

  .percentage-text {
    font-size: 0.75rem;
    font-weight: 600;
    color: #000;
    position: relative;
    z-index: 1;
  }

  @keyframes shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  @media (max-width: 768px) {
    .rootme-category-stats {
      padding: 1rem;
    }

    .category-info {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .category-progress {
      font-size: 0.8rem;
    }
  }
</style>
