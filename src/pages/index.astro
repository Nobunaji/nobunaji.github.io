---
import SkillSphere from '../components/SkillSphere.astro';
import RootMeBadge from '../components/RootMeBadge.astro';
import indexScript from '../scripts/index.js?raw';
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Nobunaji | Cyber Portfolio</title>
    <style>
      @import url('../styles/index.css');
    </style>
  </head>
  <body>
    <canvas id="matrix" aria-hidden="true"></canvas>
    <main>
      <div class="header-controls">
        <h1>root@portfolio:~#</h1>
        <button id="lang-toggle" class="lang-toggle" aria-label="Toggle language" title="English / Français">
          <span class="lang-icon">🌐</span> <span class="lang-text">EN</span>
        </button>
      </div>
      <p class="lead" data-en="Minimal cyber portfolio in Astro." data-fr="Portfolio cyber minimal en Astro.">Portfolio cyber minimal en Astro.</p>
      
      <section class="buttons-grid">
        <button class="feature-button" id="rootme-btn">
          <div class="button-header">
            <h3 data-en="Root-me" data-fr="Root-me">Root-me</h3>
            <RootMeBadge />
          </div>
          <p class="button-desc" data-en="Security challenges and CTF platform" data-fr="Plateforme de défis de sécurité et CTF">Plateforme de défis de sécurité et CTF</p>
        </button>

        <button class="feature-button">
          <div class="button-header">
            <h3 data-en="Lorem Ipsum" data-fr="Lorem Ipsum">Lorem Ipsum</h3>
          </div>
          <p class="button-desc" data-en="Lorem Ipsum" data-fr="Lorem Ipsum">Lorem Ipsum</p>
        </button>

        <button class="feature-button">
          <div class="button-header">
            <h3 data-en="Lorem Ipsum" data-fr="Lorem Ipsum">Lorem Ipsum</h3>
          </div>
          <p class="button-desc" data-en="Lorem Ipsum" data-fr="Lorem Ipsum">Lorem Ipsum</p>
        </button>
      </section>
      
      <section class="terminal" aria-label="Terminal interactif">
        <div class="output" id="output" data-en-placeholder="Type a command:&#10;help" data-fr-placeholder="Tape une commande:&#10;help">Tape une commande:
help
        </div>
        <div class="prompt-line">
          <span class="prompt">root@portfolio:~#</span>
          <input id="cmd" autocomplete="off" spellcheck="false" aria-label="Commande terminal" />
        </div>
      </section>
      <p class="hint" data-en="Commands: help, ls, cat skills.md, contact, clear" data-fr="Commandes: help, ls, cat skills.md, contact, clear">Commandes: <code>ls</code>, <code>cat skills.md</code>, <code>contact</code>, <code>clear</code></p>
    </main>

    <footer>
      <p>&copy; <span id="year"></span> Nobunaji - Hosted on Github Pages</p>
    </footer>

    <script is:inline set:html={indexScript}></script>
  </body>
</html>
